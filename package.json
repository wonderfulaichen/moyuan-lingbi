{
  "name": "moyuan-lingbi",
  "private": true,
  "version": "0.3.7",
  "description": "墨渊灵笔 - AI小说创作工坊。一款基于AI辅助的小说创作工具，帮助作者从灵感萌发到完成整部小说。",
  "author": "wonderful艾辰",
  "license": "MIT",
  "main": "build/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5180 && electron .\"",
    "electron:build": "npm run build && npm run build:electron",
    "electron:build-win": "npm run electron:build && electron-builder --win",
    "electron:build-mac": "npm run electron:build && electron-builder --mac",
    "electron:build-linux": "npm run electron:build && electron-builder --linux",
    "build:electron": "mkdir build\\main 2>nul & copy src\\main\\main.js build\\main\\main.js & copy src\\main\\preload.js build\\main\\preload.js",
    "build:android": "vite build && npx cap sync android",
    "build:android:release": "vite build && npx cap sync android && cd android && .\\gradlew assembleRelease",
    "build:pwa": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:colors": "node scripts/check-tailwind-colors.mjs",
    "lint:colors:staged": "node scripts/check-tailwind-colors.mjs --staged",
    "setup:hooks": "node scripts/install-hook.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@xyflow/react": "^12.10.2",
    "node-llama-cpp": "^3.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.8.9",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.3"
  }
}
